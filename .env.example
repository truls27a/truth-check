# Set false to analyze the current video's transcript with configured services.
DEMO_MODE=true
PORT=8787

# Which LLM backend to use for live analysis: "openai" or "ollama".
LLM_PROVIDER=openai

# Used when LLM_PROVIDER=openai. Create this key in the OpenAI Platform dashboard.
LLM_API_KEY="Your OpenAI API key here"
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-luna

# Used when LLM_PROVIDER=ollama. Points at a local Ollama server — no API
# key needed. Run `ollama serve` and `ollama pull qwen2.5-coder:3b` first.
# Note: local Ollama models have no web_search tool, so live-check
# verdicts rely on the model's own knowledge rather than fresh evidence.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
