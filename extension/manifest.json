{
  "manifest_version": 3,
  "name": "TruthCheck",
  "version": "0.3.0",
  "description": "Verify factual claims as you watch YouTube, or fact-check any text you select.",
  "permissions": ["contextMenus", "scripting", "activeTab", "storage"],
  "host_permissions": [
    "https://truth-check-tool.lovable.app/*",
    "https://c--18989893-2e9e-4c1d-af2b-9d5cc74c2c93-prod.lovable.cloud/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TruthCheck",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://www.youtube.com/*"], "js": ["config.js", "card.js", "content.js"], "css": ["styles.css", "live.css"], "run_at": "document_idle" }]
}
